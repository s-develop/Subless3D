/*

================================================================================
  Plasma Bloom — organic glowing flow field
================================================================================

  Author:        https://github.com/s-develop
  Year:          2026
  Project:       Subless3D
  License:       Apache License 2.0

  Original work. No code shared with any third-party shader.

  Visual:
      Bright organic knots of light floating on a dark background.
      Colors cycle through the spectrum as a function of position.
      Edges of the plasma folds show a subtle chromatic shift toward
      magenta and blue. The whole field drifts and breathes.

  Method:

      * Instead of nested sin/cos iteration, we use a two-level
        domain warp:

            q = fbm(p)
            r = fbm(p + q * K)
            d = fbm(p + r * K)

        The final scalar d has a rich set of level curves that look
        like turbulent plasma.

      * Glow comes from a ridge transform on a second independent
        field — 1 / (1 + k * d²) — which puts bright peaks on the
        zero-crossings of the field. The output is a smooth field
        of bright knots and dark valleys, not a binary shape.

      * The color phase is driven by a third independent FBM. Each
        region of the image gets a slowly varying hue, so the whole
        composition reads as one connected flow with local color.

      * Chromatic aberration is applied analytically: the R and B
        channels are shifted toward opposite edges, scaled by the
        distance from the center.

      * Tone mapping is a smooth rational curve (e^x - 1) / (e^x + 1),
        which compresses highlights without clipping.

================================================================================
*/

uniform float2 resolution;
uniform float time;

// ============================================================
//  Hash and value noise
// ============================================================

float hash21(float2 p) {
    p = fract(p * float2(0.1031, 0.1030));
    p = p + dot(p, p.yx + 33.33);
    return fract((p.x + p.y) * p.x);
}

float vnoise(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);

    float a = hash21(i);
    float b = hash21(i + float2(1.0, 0.0));
    float c = hash21(i + float2(0.0, 1.0));
    float d = hash21(i + float2(1.0, 1.0));

    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

float fbm4(float2 p) {
    float v = 0.0;
    float a = 0.5;
    float tot = 0.0;
    for (int i = 0; i < 4; i++) {
        v = v + a * vnoise(p);
        tot = tot + a;
        p = p * 2.03 + float2(7.3, 3.1);
        a = a * 0.5;
    }
    return v / max(tot, 1e-5);
}

// ============================================================
//  Two-level domain warp
// ============================================================

float warpedField(float2 p, float t) {
    float2 dr = float2(t * 0.06, t * 0.04);

    // Level 1
    float2 q = float2(
        fbm4(p + dr),
        fbm4(p + dr + float2(5.2, 1.9))
    ) - 0.5;

    // Level 2
    float2 p2 = p + q * 1.30;
    float2 r = float2(
        fbm4(p2 + dr),
        fbm4(p2 + dr + float2(9.1, 3.7))
    ) - 0.5;

    // Final scalar
    float d = fbm4(p + r * 1.10 + dr);

    return d;
}

// ============================================================
//  Glow — inverse-square peaks on a separate field
// ============================================================

float glowField(float2 p, float t) {
    float2 dr = float2(-t * 0.03, t * 0.05);

    // Ridge on a warped field — puts bright knots on the fold lines
    float2 q = float2(
        fbm4(p * 1.30 + dr),
        fbm4(p * 1.30 + dr + float2(3.7, 8.3))
    ) - 0.5;

    float d = fbm4(p * 0.90 + q * 0.85 + dr);

    // Distance to the middle of the field, where the folds are
    float mid = d - 0.5;
    float g = 1.0 / (1.0 + mid * mid * 55.0);

    return g;
}

// ============================================================
//  main
// ============================================================

half4 main(float2 fragCoord) {
    // Centered UV, aspect-corrected
    float2 uv = (fragCoord - 0.5 * resolution) / resolution.y;

    // Scale up — a large structure of folds fills the screen
    float2 p = uv * 5.5;

    // ---- Two independent fields ----
    float d = warpedField(p, time);
    float g = glowField(p, time);

    // ---- Color phase from a third independent field ----
    float hueF = fbm4(p * 0.45 + float2(time * 0.02, -time * 0.03));

    // Hue in [0, 1) — three-channel cosine for smooth cycling
    float3 chroma = 0.5 + 0.5 * cos(
        6.28318 * (hueF * 0.6 + 0.15) + float3(0.0, 2.0, 4.0)
    );

    // Push saturation up: subtract grey component
    float lum = dot(chroma, float3(0.299, 0.587, 0.114));
    chroma = chroma + (chroma - float3(lum, lum, lum)) * 0.75;
    chroma = clamp(chroma, float3(0.0), float3(1.0));

    // ---- Compose ----
    // Base: dark plasma with a subtle purple tint
    float3 col = float3(0.020, 0.015, 0.045);

    // Fold field adds the "shape" — bright along the ridges
    float foldMask = pow(clamp(g, 0.0, 1.0), 1.6);
    col = col + chroma * foldMask * 2.2;

    // Add soft ambient glow from the warp field
    float soft = pow(clamp(1.0 - abs(d - 0.5) * 2.0, 0.0, 1.0), 4.0);
    col = col + chroma * soft * 0.6;

    // Dark veining where the field is at its extremes
    float vein = smoothstep(0.15, 0.0, abs(d - 0.5)) * 0.5;
    col = mix(col, col * 0.4, vein);

    // ---- Chromatic aberration on edges ----
    float edgeDist = length(uv);
    col.r = col.r * (1.0 + edgeDist * 0.20);
    col.b = col.b * (1.0 + edgeDist * 0.30);
    col.g = col.g * (1.0 - edgeDist * 0.05);

    // ---- Bright core accent ----
    // Where glow peaks AND the hue field is near its maximum
    float core = smoothstep(0.75, 0.98, foldMask) * smoothstep(0.55, 0.85, hueF);
    col = col + float3(1.0, 0.90, 0.70) * core * 1.4;

    // ---- Filmic rational tone ----
    // (e^x - 1) / (e^x + 1) — smooth compression, no hard clip
    float3 e2 = exp(1.6 * col);
    col = (e2 - 1.0) / (e2 + 1.0);

    // ---- Vignette ----
    float vig = smoothstep(1.30, 0.35, edgeDist);
    col = col * (0.55 + 0.45 * vig);

    // ---- Final gamma lift ----
    col = pow(max(col, float3(0.0)), float3(0.92));

    return half4(half3(clamp(col, float3(0.0), float3(1.0))), 1.0);
}